rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to verify user authentication
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to verify user is accessing their own private profile
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Farmers collection and private subcollections
    match /farmers/{farmerId} {
      // Farmers can only read and write their own profile
      allow read, write: if isOwner(farmerId);

      // Private Lands subcollection: farmers/{userId}/lands/{landId}
      match /lands/{landId} {
        allow read, write: if isOwner(farmerId);

        // Independent subcollections for Soil, Irrigation, Diseases, Tasks, Conflicts
        match /soilHealth/{docId} {
          allow read, write: if isOwner(farmerId);
        }

        match /weather/{docId} {
          allow read, write: if isOwner(farmerId);
        }

        match /irrigation/{docId} {
          allow read, write: if isOwner(farmerId);
        }

        match /tasks/{docId} {
          allow read, write: if isOwner(farmerId);
        }

        match /conflicts/{docId} {
          allow read, write: if isOwner(farmerId);
        }
      }
    }

    // Buyers collection
    match /buyers/{buyerId} {
      // Buyers can only read and write their own profile
      allow read, write: if isOwner(buyerId);

      // Buyer enquiries
      match /enquiries/{enquiryId} {
        allow read, write: if isOwner(buyerId);
      }
    }

    // Marketplace produce listings (Publicly viewable by verified users, only owner farmer can edit/delete)
    match /marketplace_listings/{listingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.farmerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.farmerId == request.auth.uid;
    }
  }
}
